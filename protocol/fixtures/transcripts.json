{
  "happy-path": {
    "note": "two files, one zero-byte; receiver acks and finishes",
    "steps": [
      {
        "from": "sender",
        "frame": {
          "t": "manifest",
          "files": [
            {
              "id": 0,
              "name": "hello.txt",
              "size": 11,
              "type": "text/plain"
            },
            {
              "id": 1,
              "name": "empty.bin",
              "size": 0,
              "type": ""
            }
          ]
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "request",
          "id": 0,
          "offset": 0
        }
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_start",
          "id": 0,
          "offset": 0
        }
      },
      {
        "from": "sender",
        "bin": "68656c6c6f"
      },
      {
        "from": "sender",
        "bin": "20776f726c64"
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_end",
          "id": 0,
          "hash": "45ab6734b21e6968"
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "file_done",
          "id": 0
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "request",
          "id": 1,
          "offset": 0
        }
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_start",
          "id": 1,
          "offset": 0
        }
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_end",
          "id": 1,
          "hash": "ef46db3751d8e999"
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "file_done",
          "id": 1
        }
      }
    ],
    "expect": {
      "files": [
        {
          "id": 0,
          "name": "hello.txt",
          "bytes": 11,
          "hash": "45ab6734b21e6968"
        },
        {
          "id": 1,
          "name": "empty.bin",
          "bytes": 0,
          "hash": "ef46db3751d8e999"
        }
      ],
      "error": null
    }
  },
  "duplicate-names": {
    "note": "files are keyed by id; the receiver must save both without collision",
    "steps": [
      {
        "from": "sender",
        "frame": {
          "t": "manifest",
          "files": [
            {
              "id": 0,
              "name": "a.txt",
              "size": 2,
              "type": ""
            },
            {
              "id": 1,
              "name": "a.txt",
              "size": 2,
              "type": ""
            }
          ]
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "request",
          "id": 0,
          "offset": 0
        }
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_start",
          "id": 0,
          "offset": 0
        }
      },
      {
        "from": "sender",
        "bin": "6162"
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_end",
          "id": 0,
          "hash": "65f708ca92d04a61"
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "file_done",
          "id": 0
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "request",
          "id": 1,
          "offset": 0
        }
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_start",
          "id": 1,
          "offset": 0
        }
      },
      {
        "from": "sender",
        "bin": "6162"
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_end",
          "id": 1,
          "hash": "65f708ca92d04a61"
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "file_done",
          "id": 1
        }
      }
    ],
    "expect": {
      "files": [
        {
          "id": 0,
          "name": "a.txt",
          "bytes": 2,
          "hash": "65f708ca92d04a61"
        },
        {
          "id": 1,
          "name": "a.txt",
          "bytes": 2,
          "hash": "65f708ca92d04a61"
        }
      ],
      "error": null
    }
  },
  "hostile-names": {
    "note": "receiver must sanitize before touching disk; sanitized names are listed in expect",
    "steps": [
      {
        "from": "sender",
        "frame": {
          "t": "manifest",
          "files": [
            {
              "id": 0,
              "name": "../../etc/passwd",
              "size": 0,
              "type": ""
            },
            {
              "id": 1,
              "name": "CON",
              "size": 0,
              "type": ""
            },
            {
              "id": 2,
              "name": "a\u001b[31mb\\c/d.txt",
              "size": 0,
              "type": ""
            }
          ]
        }
      }
    ],
    "expect": {
      "files": [
        {
          "id": 0,
          "name": "passwd"
        },
        {
          "id": 1,
          "name": "_CON"
        },
        {
          "id": 2,
          "name": "a[31mb_c_d.txt"
        }
      ],
      "error": null
    }
  },
  "cancel-declined": {
    "note": "receiver declines the manifest",
    "steps": [
      {
        "from": "sender",
        "frame": {
          "t": "manifest",
          "files": [
            {
              "id": 0,
              "name": "x",
              "size": 1,
              "type": ""
            }
          ]
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "cancel",
          "reason": "declined"
        }
      }
    ],
    "expect": {
      "files": [],
      "error": "declined"
    }
  },
  "hash-mismatch": {
    "note": "bytes arrive but hash differs: receiver aborts and cancels",
    "steps": [
      {
        "from": "sender",
        "frame": {
          "t": "manifest",
          "files": [
            {
              "id": 0,
              "name": "x.txt",
              "size": 2,
              "type": ""
            }
          ]
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "request",
          "id": 0,
          "offset": 0
        }
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_start",
          "id": 0,
          "offset": 0
        }
      },
      {
        "from": "sender",
        "bin": "6162"
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_end",
          "id": 0,
          "hash": "0000000000000000"
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "cancel",
          "reason": "hash_mismatch"
        }
      }
    ],
    "expect": {
      "files": [],
      "error": "hash_mismatch"
    }
  },
  "resume": {
    "note": "receiver already holds 5 bytes of file 0 (hasher state kept); sender restarts at offset 5",
    "receiverHasBytes": {
      "0": 5
    },
    "steps": [
      {
        "from": "sender",
        "frame": {
          "t": "manifest",
          "files": [
            {
              "id": 0,
              "name": "hello.txt",
              "size": 11,
              "type": ""
            }
          ]
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "request",
          "id": 0,
          "offset": 5
        }
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_start",
          "id": 0,
          "offset": 5
        }
      },
      {
        "from": "sender",
        "bin": "20776f726c64"
      },
      {
        "from": "sender",
        "frame": {
          "t": "file_end",
          "id": 0,
          "hash": "45ab6734b21e6968"
        }
      },
      {
        "from": "receiver",
        "frame": {
          "t": "file_done",
          "id": 0
        }
      }
    ],
    "expect": {
      "files": [
        {
          "id": 0,
          "name": "hello.txt",
          "bytes": 11,
          "hash": "45ab6734b21e6968"
        }
      ],
      "error": null
    }
  },
