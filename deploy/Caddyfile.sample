# Sample Caddyfile for WarpDrop. Drop into your Caddy config and replace YOUR_DOMAIN.
# Caddy gets HTTPS from Let's Encrypt automatically, and reverse_proxy handles the WebSocket upgrades on
# /ws and /relay/ with no extra settings. Ports 80 and 443 must be open and the A record must point here.

# The app: web UI, /ws signaling, /relay/ encrypted relay and /api/config, all from one upstream.
YOUR_DOMAIN {
	reverse_proxy 127.0.0.1:8080 {
		# relayed transfers can pause for a while (a user deciding); don't cut idle upstream connections early
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}
}

# The curl | bash installer endpoint
install.YOUR_DOMAIN {
	reverse_proxy 127.0.0.1:8000
}
