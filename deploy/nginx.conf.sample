# Sample Nginx config for WarpDrop. Include it inside `http { }` and replace YOUR_DOMAIN.
# One upstream serves everything. Only /ws and /relay/ need WebSocket upgrade headers.
# Add your own ssl_certificate lines (certbot, acme.sh, ...).

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

upstream warpdrop {
  server 127.0.0.1:8080;
  keepalive 16;
}

server {
  listen 80;
  server_name YOUR_DOMAIN install.YOUR_DOMAIN;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name YOUR_DOMAIN;

  # ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

  location / {
    proxy_pass http://warpdrop;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # signaling and the encrypted relay
  location ~ ^/(ws|relay/) {
    proxy_pass http://warpdrop;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;          # relayed file data must stream, not pile up in nginx
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name install.YOUR_DOMAIN;

  # ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;

  location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
