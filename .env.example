# Copy to .env. Everything here is optional; the defaults give a working single-container setup.

# Image tag to run (a release such as 2.0.0, or latest)
# WARPDROP_VERSION=latest

# Encrypted WebSocket relay used when peers cannot connect directly. "off" disables it.
# RELAY=on
# Per-connection cap in megabits per second (0 = unlimited), and the number of simultaneous relays
# RELAY_MAX_MBPS=0
# RELAY_MAX_CONNS=200

# Extra browser origins allowed to open the WebSocket, comma separated (the site's own host is always allowed)
# ALLOWED_ORIGINS=https://other.example.com

# Proxies whose X-Forwarded-For is trusted (rate limits use the real client IP). Default covers a host proxy.
# TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# Behind Cloudflare's proxy also add its ranges (DEPLOY.md, "Behind Cloudflare"), or every client looks like a Cloudflare address.

# Android app: signing-cert SHA-256 fingerprint(s), so share links open the app (only for your own build of it)
# ANDROID_CERT_SHA256=
# ANDROID_PACKAGE=com.biohazard786.warpdrop

# STUN server(s), comma separated
# STUN_URLS=stun:stun.l.google.com:19302

# --- TURN (optional, `docker compose --profile turn up -d`) ---
# Generate once:  openssl rand -hex 32
# TURN_SECRET=
# What browsers and the CLI connect to, e.g. turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_URLS=
# TURN_REALM=turn.example.com
# TURN_EXTERNAL_IP=203.0.113.10
